{
  "name": "jevals",
  "version": "0.1.0",
  "description": "Local evaluation workbench for TypeSafe Jev",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test:browser": "npm run build && node --import tsx test/workbench.browser.mjs",
    "preview": "JEVALS_SERVE_BUILD=1 tsx src/server.ts",
    "seed": "tsx src/seed-examples.ts",
    "prepack": "npm run build",
    "test:package": "node test/package.acceptance.mjs"
  },
  "keywords": [
    "jev",
    "evals",
    "typesafe",
    "webmcp"
  ],
  "author": "Nick DeJesus",
  "license": "MIT",
  "type": "module",
  "files": [
    "index.js",
    "bin/",
    "lib/",
    "dist/",
    "examples/",
    "skills/jevals/",
    "public/fonts/Inter-OFL.txt"
  ],
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^18.0.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "jevals": "bin/jevals.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dayhaysoos/jevals.git"
  },
  "bugs": {
    "url": "https://github.com/dayhaysoos/jevals/issues"
  }
}
